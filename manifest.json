{
  "manifest_version": 3,
  "name": "TWP Script Deployer",
  "version": "1.0.0",
  "description": "A Chrome extension built with React + Vite.",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://clock.payrollservers.us/*"],
      "js": ["src/content/index.ts"]
    }
  ],
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["https://www.swipeclock.com/*", "https://clock.payrollservers.us/*"]
}
