{
  "manifest_version": 3,
  "name": "TWP Script Deployer",
  "version": "1.0.0",
  "description": "Deploy and manage custom scripts across TimeWorksPlus (TWP) pages from a single popup.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://clock.payrollservers.us/*"],
      "js": ["src/content/index.ts"]
    }
  ],
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["https://www.swipeclock.com/*", "https://clock.payrollservers.us/*"]
}
